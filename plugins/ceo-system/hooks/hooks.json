{
  "description": "CEO-system guardrails: block destructive, production and secret-touching tool calls",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deny-dangerous.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
